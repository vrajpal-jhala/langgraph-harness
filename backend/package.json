{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": {
      "harness-src": "./src/*",
      "default": "./build/*"
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "migrate": "cross-env NODE_OPTIONS=--conditions=harness-src tsx --env-file=.env ./scripts/migrate.ts up",
    "migrate:down": "cross-env NODE_OPTIONS=--conditions=harness-src tsx --env-file=.env ./scripts/migrate.ts down",
    "scrape:issues": "cross-env NODE_OPTIONS=--conditions=harness-src tsx ./scripts/scrape_issues.ts",
    "dev": "cross-env NODE_OPTIONS=--conditions=harness-src tsx watch --env-file=.env --watch src src/index.ts",
    "build": "node ./node_modules/typescript-native/bin/tsc && cp -r src/skills build/skills && cp -r src/tokenizers build/tokenizers",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint . --fix",
    "gen:types": "dts-bundle-generator --config dts-bundle.config.cjs",
    "preview": "NODE_ENV=production node --env-file=.env ./build/index.js"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.1.0",
    "@better-auth/kysely-adapter": "1.7.7",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/node": "1.4.5",
    "@huggingface/transformers": "4.3.0",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/mcp-adapters": "2.0.0",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.6.2",
    "@langchain/openrouter": "0.4.17",
    "@mozilla/readability": "0.6.0",
    "@zereight/mcp-gitlab": "2.1.69",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "busboy": "1.6.0",
    "cron-parser": "5.10.1",
    "elysia": "1.4.30",
    "execa": "10.0.1",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.1.2",
    "kysely": "0.29.6",
    "langchain": "1.5.15",
    "micromatch": "4.0.8",
    "p-limit": "7.3.3",
    "patch-package": "8.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "puppeteer-core": "25.12.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/busboy": "1.5.4",
    "@types/jsdom": "30.0.0",
    "@types/micromatch": "4.0.10",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "cross-env": "10.1.0",
    "dts-bundle-generator": "9.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "module": "src/index.js"
}
